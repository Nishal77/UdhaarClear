# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma — use Supabase connection pooler URL)
DATABASE_URL=
DIRECT_URL=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret from the Meta App dashboard (Settings > Basic) — used to verify
# the x-hub-signature-256 header on inbound webhooks. NOT the access token.
WHATSAPP_APP_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL= # Example: UdhaarClear <noreply@yourdomain.com> (optional, overrides default sandbox email)

# App
NEXT_PUBLIC_APP_URL=https://udhaarclear.in
NEXT_PUBLIC_APP_NAME=UdhaarClear
CRON_SECRET=

# Supabase Storage
SUPABASE_STORAGE_BUCKET=documents

# Sentry (error tracking)
# DSN from Sentry project settings. Server + client use the SAME DSN value —
# NEXT_PUBLIC_ prefix is required for the client one because it's bundled
# into browser JS; SENTRY_DSN (no prefix) is used server-side only.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI, for uploading source maps at build time so Sentry can
# show real source lines instead of minified code. Not needed for local dev.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
