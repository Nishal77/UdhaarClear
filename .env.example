# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma — use Supabase connection pooler URL)
DATABASE_URL=
DIRECT_URL=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret from the Meta App dashboard (Settings > Basic) — used to verify
# the x-hub-signature-256 header on inbound webhooks. NOT the access token.
WHATSAPP_APP_SECRET=
# Language code the WhatsApp templates are registered under in Meta WhatsApp
# Manager. MUST match exactly (e.g. "en" vs "en_US") or Meta silently rejects
# every send even though the template is approved. Defaults to "en".
WHATSAPP_TEMPLATE_LANG=en

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OPTIONAL — pin specific Razorpay Plan ids per tier. Leave BLANK and the app
# auto-creates the correctly-priced monthly plan on first checkout (prices come
# from lib/pricing.ts: STARTER ₹399, GROWTH ₹999, CA_PRO ₹9,999). Set these only
# if you created the plans manually in the Razorpay dashboard and want to use
# those exact ids instead. See lib/razorpay/plans.ts.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=
RAZORPAY_PLAN_ID_CA_PRO=

# RazorpayX Payouts — a SEPARATE product/account from standard Razorpay
# above, used only for the monthly CA commission payouts (lib/ca/payouts.ts).
# Needs its own RazorpayX business account; not the same key pair as
# RAZORPAY_KEY_ID/SECRET. Not validated against a live account — see the
# warning comment at the top of lib/ca/payouts.ts before relying on this.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL= # Example: UdhaarClear <noreply@yourdomain.com> (optional, overrides default sandbox email)

# App
NEXT_PUBLIC_APP_URL=https://udhaarclear.in
NEXT_PUBLIC_APP_NAME=UdhaarClear
CRON_SECRET=

# Supabase Storage
SUPABASE_STORAGE_BUCKET=documents

# Sentry (error tracking)
# DSN from Sentry project settings. Server + client use the SAME DSN value —
# NEXT_PUBLIC_ prefix is required for the client one because it's bundled
# into browser JS; SENTRY_DSN (no prefix) is used server-side only.
SENTRY_DSN=https://ea1c9dbdac8f7c4322ccc8c5cb8cda02@o4509778049892352.ingest.us.sentry.io/4511677935910912
NEXT_PUBLIC_SENTRY_DSN=https://ea1c9dbdac8f7c4322ccc8c5cb8cda02@o4509778049892352.ingest.us.sentry.io/4511677935910912
# Only needed in CI, for uploading source maps at build time so Sentry can
# show real source lines instead of minified code. Not needed for local dev.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
