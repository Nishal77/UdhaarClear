generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USERS & ORGANIZATIONS
// ─────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  email      String   @unique
  name       String
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ownedBusiness Business?      @relation("BusinessOwner")
  caProfile     CAProfile?
  subscriptions Subscription[]

  @@map("users")
}

model Business {
  id      String @id @default(cuid())
  ownerId String @unique
  owner   User   @relation("BusinessOwner", fields: [ownerId], references: [id])

  name      String
  legalName String?
  gstin     String?
  phone     String
  email     String?
  address   String?
  city      String?
  state     String?
  logoUrl   String?

  wabaId      String?
  waPhoneId   String?
  waConnected Boolean @default(false)

  // Payment collection details
  upiId           String?
  bankAccountNo   String?
  bankIfsc        String?
  bankAccountName String?

  planTier PlanTier @default(FREE)

  caId String?
  ca   CAProfile? @relation(fields: [caId], references: [id])

  customers  Customer[]
  invoices   Invoice[]
  reminders  Reminder[]
  aiInsight  AiInsight?
  caEarnings CAEarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

model CAProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  firmName String
  phone    String @unique

  // ── ICAI verification ──
  icaiMembershipNumber String               @unique
  copNumber            String?
  verificationStatus   CAVerificationStatus @default(PENDING)
  verifiedAt           DateTime?
  // One-time code sent to `phone` via WhatsApp to prove the CA controls the
  // number on their ICAI record. Cleared once verified — see
  // lib/ca/otp.ts for generate/verify logic.
  otpCode              String?
  otpExpiresAt         DateTime?
  otpAttempts          Int                  @default(0)

  // ── Referral (last-touch at signup, locked forever after) ──
  // Public link shape: https://udhaarclear.in/signup?ref=<referralCode>
  // No code path may update Business.caId once set at signup — that's what
  // makes attribution permanent. See lib/ca/referral.ts.
  referralCode String @unique

  // ── Payout details (Razorpay Payouts / RazorpayX) ──
  razorpayContactId     String?
  razorpayFundAccountId String?
  bankAccountNo         String?
  bankIfsc              String?
  bankAccountName       String?

  clients  Business[]
  earnings CAEarning[]
  payouts  CAPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ca_profiles")
}

enum CAVerificationStatus {
  PENDING        // registered, OTP not yet sent
  OTP_SENT       // waiting on the CA to enter the code
  VERIFIED       // phone confirmed — can see the dashboard
  MANUAL_REVIEW  // ICAI directory check was inconclusive, needs a human look
  REJECTED
}

// One row per (CA, referred business, calendar month) — the commission
// earned for that client being on a paid plan that month. Generated by the
// monthly cron in lib/cron/ca-monthly-payout.ts, then grouped into a
// CAPayout once the month closes.
model CAEarning {
  id          String    @id @default(cuid())
  caId        String
  ca          CAProfile @relation(fields: [caId], references: [id])
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  planTier    PlanTier
  amount      Decimal   @db.Decimal(10, 2)
  periodMonth Int // 1-12
  periodYear  Int
  payoutId    String?
  payout      CAPayout? @relation(fields: [payoutId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([caId, businessId, periodMonth, periodYear])
  @@index([caId])
  @@map("ca_earnings")
}

// One row per (CA, month) — the aggregated payout batch, after TDS.
model CAPayout {
  id               String         @id @default(cuid())
  caId             String
  ca               CAProfile      @relation(fields: [caId], references: [id])
  periodMonth      Int
  periodYear       Int
  grossAmount      Decimal        @db.Decimal(10, 2)
  tdsAmount        Decimal        @db.Decimal(10, 2)
  netAmount        Decimal        @db.Decimal(10, 2)
  status           CAPayoutStatus @default(PENDING)
  razorpayPayoutId String?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())

  earnings CAEarning[]

  @@unique([caId, periodMonth, periodYear])
  @@map("ca_payouts")
}

enum CAPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  CA_PRO
}

// ─────────────────────────────────────────────
// CUSTOMERS (DEBTORS)
// ─────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  phone       String
  email       String?
  gstin       String?
  address     String?
  city        String?

  defaultTone ReminderTone @default(GENTLE)

  notes     String?
  isBlocked Boolean @default(false)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, phone])
  @@map("customers")
}

// ─────────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────────

model Invoice {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  invoiceNumber String
  amount        Decimal  @db.Decimal(12, 2)
  description   String?
  invoiceDate   DateTime
  dueDate       DateTime
  creditDays    Int      @default(30)
  documentUrl   String?

  status        InvoiceStatus @default(PENDING)
  paidAmount    Decimal?      @db.Decimal(12, 2)
  paidAt        DateTime?
  paymentMethod String?
  paymentRef    String?

  reminderTone    ReminderTone @default(GENTLE)
  autoReminder    Boolean      @default(true)
  remindersPaused Boolean      @default(false)

  // Set when a seller snoozes reminders for a fixed window (e.g. "buyer
  // promised payment in 7 days") instead of pausing indefinitely. The cron
  // reminder engine auto-clears remindersPaused once this date passes — see
  // autoExpireSnoozedInvoices() in lib/cron/reminder-engine.ts. Null means
  // either "not paused" or "paused indefinitely" (no auto-resume).
  remindersPausedUntil DateTime?

  razorpayLinkId  String?
  razorpayLinkUrl String?

  legalNoticeGeneratedAt DateTime?
  legalNoticeSentAt      DateTime?

  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([customerId])
  @@index([paidAt])
  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  DUE
  OVERDUE
  PENDING_CONFIRMATION
  PARTIALLY_PAID
  PAID
  DISPUTED
  WRITTEN_OFF
}

enum ReminderTone {
  GENTLE
  FIRM
  LEGAL
}

// ─────────────────────────────────────────────
// REMINDERS
// ─────────────────────────────────────────────

model Reminder {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  channel      ReminderChannel @default(WHATSAPP)
  tone         ReminderTone
  templateName String
  messageBody  String
  dayOverdue   Int

  status      ReminderStatus @default(SENT)
  waMessageId String?
  deliveredAt DateTime?
  readAt      DateTime?
  failReason  String?
  outcome     String?

  paymentLinkUrl String?
  triggeredBy    TriggerSource @default(AUTO)

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([invoiceId])
  @@map("reminders")
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
  SMS
  BOTH
}

enum ReminderStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  REPLIED
}

enum TriggerSource {
  AUTO
  MANUAL
}

// ─────────────────────────────────────────────
// SUBSCRIPTIONS
// ─────────────────────────────────────────────

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  planTier           PlanTier
  billingCycle       BillingCycle       @default(MONTHLY)
  status             SubscriptionStatus @default(ACTIVE)
  razorpaySubId      String?            @unique
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

// ─────────────────────────────────────────────
// AI PREDICTIVE INSIGHTS CACHE
// ─────────────────────────────────────────────

model AiInsight {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  insights   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ai_insights")
}

// ─────────────────────────────────────────────
// AUTH OTP & RATE LIMITS
// ─────────────────────────────────────────────

model OtpSession {
  id        String   @id @default(cuid())
  email     String
  name      String?
  otp       String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otp_sessions")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rate_limits")
}

// ─────────────────────────────────────────────
// WEBHOOK IDEMPOTENCY
// ─────────────────────────────────────────────

// Records every processed webhook event so retries (which payment
// providers send on any network hiccup) never get applied twice.
// Insert happens BEFORE processing — the unique constraint on
// (provider, eventId) is what actually blocks the duplicate; if the
// insert fails, we know this exact event already ran.
model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String // e.g. "razorpay", "whatsapp"
  eventId   String // provider's unique id for this event (e.g. Razorpay payment id)
  eventType String // e.g. "payment_link.paid"
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}


